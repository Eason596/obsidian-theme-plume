{
  "name": "theme-plume",
  "version": "1.2.1",
  "private": true,
  "description": "VuePress Theme Plume markdown extensions for Obsidian.",
  "license": "MIT",
  "author": "JY",
  "type": "module",
  "scripts": {
    "generate:vuepress-icons": "node scripts/generate-vuepress-file-icons.mjs",
    "generate:icons": "npm run generate:vuepress-icons",
    "dev": "npm run generate:vuepress-icons && node esbuild.config.mjs",
    "build": "npm run check && npm run generate:vuepress-icons && node esbuild.config.mjs production",
    "build:demo": "node scripts/build-demo.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:legacy": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^20.17.57",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.5",
    "github-slugger": "^2.0.0",
    "happy-dom": "^20.0.10",
    "marked": "^15.0.12",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@shikijs/core": "^4.3.1",
    "@shikijs/engine-javascript": "^4.3.1",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@shikijs/types": "^4.3.1",
    "qrcode": "^1.5.4"
  }
}
